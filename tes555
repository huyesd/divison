function Section:AddKeybind(options)
    options = options or {}
    local text = options.Text or "Keybind"
    local defaultKey = options.Default and Enum.KeyCode[options.Default] or Enum.KeyCode.None
    local callback = options.Callback or function() end

    local row = New("TextButton", self.ItemsContainer, {
        Name = "Keybind",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, ITEM_HEIGHT),
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        LayoutOrder = #self.ItemsContainer:GetChildren() + 1,
    })

    local label = New("TextLabel", row, {
        Name = "Text",
        BackgroundTransparency = 1,
        Text = text .. ":",
        TextColor3 = COLORS.Text,
        FontFace = FONTS.Default,
        TextScaled = true,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        Size = UDim2.new(0, 200, 0, 9),
        Position = UDim2.new(0.07, 0, -0.125, 0),
        LayoutOrder = 1,
        BorderSizePixel = 0,
    })

    local keyButton = New("TextButton", row, {
        Name = "KeyButton",
        BackgroundColor3 = COLORS.ToggleOff,
        Text = (defaultKey ~= Enum.KeyCode.None) and defaultKey.Name or "None",
        TextColor3 = COLORS.Text,
        FontFace = FONTS.Bold,
        TextScaled = true,
        TextSize = 14,
        Size = UDim2.new(0, 45, 0, ITEM_HEIGHT),
        Position = UDim2.new(0.81, 0, -0.125, 0),
        LayoutOrder = 2,
        BorderSizePixel = 0,
        AutoButtonColor = false,
    })

    New("UIListLayout", row, {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = Enum.FillDirection.Horizontal,
    })

    local currentKey = defaultKey
    local window = self.Tab.Window

    local function setKey(key)
        if currentKey and currentKey ~= Enum.KeyCode.None then
            window.Keybinds[currentKey] = nil
        end
        currentKey = key
        if key and key ~= Enum.KeyCode.None then
            keyButton.Text = key.Name
            window.Keybinds[key] = function()
                callback(key)
            end
        else
            keyButton.Text = "None"
        end
    end

    keyButton.MouseButton1Click:Connect(function()
        keyButton.Text = "..."
        local listening = true
        local conn
        conn = UserInputService.InputBegan:Connect(function(input, processed)
            if not listening then return end
            if processed then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                listening = false
                setKey(input.KeyCode)
                conn:Disconnect()
            end
        end)
        local cancelConn
        cancelConn = keyButton.MouseButton1Click:Connect(function()
            if listening then
                listening = false
                conn:Disconnect()
                cancelConn:Disconnect()
                setKey(currentKey)
            end
        end)
    end)

    setKey(defaultKey)

    return {
        Set = setKey,
        Get = function() return currentKey end,
    }
end

