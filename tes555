        Name = "ValueSlider",
        Size = UDim2.new(0, 10, 0, 150),
        Position = UDim2.new(0.75, 0, 0.02, 0),
        BackgroundColor3 = Color3.new(1,1,1),
        ZIndex = 2,
    })
    New("UIGradient", valueSlider, {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.new(0,0,0)),
            ColorSequenceKeypoint.new(1, Color3.new(1,1,1)),
        })
    })

    local valueSliderKnob = New("Frame", valueSlider, {
        Name = "Knob",
        BackgroundColor3 = COLORS.Accent,
        Size = UDim2.new(1, 0, 0, 3),
        Position = UDim2.new(0, 0, 1, 0),
        BorderSizePixel = 0,
        ZIndex = 3,
    })

    local previewBox = New("Frame", popup, {
        Name = "Preview",
        Size = UDim2.new(0, 30, 0, 20),
        Position = UDim2.new(0.75, 0, 0.72, 0),
        BackgroundColor3 = defaultColor,
        ZIndex = 2,
        BorderSizePixel = 0,
    })

    local hexBox = New("TextBox", popup, {
        Name = "HexBox",
        Size = UDim2.new(0, 80, 0, 20),
        Position = UDim2.new(0.02, 0, 0.75, 0),
        BackgroundColor3 = COLORS.ToggleOff,
        TextColor3 = COLORS.Text,
        Text = Color3ToHex(defaultColor),
        FontFace = FONTS.Default,
        TextSize = 12,
        ZIndex = 2,
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
    })

    local currentColor = defaultColor
    local h, s, v = defaultColor:ToHSV()
    if v == 0 then h, s = 0, 0 end

    local function updateColor()
        local color = Color3.fromHSV(h, s, v)
        currentColor = color
        colorPreview.BackgroundColor3 = color
        previewBox.BackgroundColor3 = color
        hexBox.Text = Color3ToHex(color)
        callback(color)
    end

    local function setHSV(newH, newS, newV)
        h = math.clamp(newH, 0, 1)
        s = math.clamp(newS, 0, 1)
        v = math.clamp(newV, 0, 1)
        valueSliderKnob.Position = UDim2.new(0, 0, 1 - v, 0)
        updateColor()
    end

    setHSV(h, s, v)

    local function getSquarePos(input)
        local pos = input.Position
        local x = (pos.X - pickerSquare.AbsolutePosition.X) / pickerSquare.AbsoluteSize.X
        local y = (pos.Y - pickerSquare.AbsolutePosition.Y) / pickerSquare.AbsoluteSize.Y
        return math.clamp(x, 0, 1), math.clamp(1 - y, 0, 1)
    end

    pickerSquare.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local newH, newS = getSquarePos(input)
            setHSV(newH, newS, v)
            local conn, relConn
            conn = UserInputService.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement then
                    local newH, newS = getSquarePos(input)
                    setHSV(newH, newS, v)
                end
            end)
            relConn = UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    conn:Disconnect()
                    relConn:Disconnect()
                end
            end)
        end
    end)

    local function getValuePos(input)
        local y = (input.Position.Y - valueSlider.AbsolutePosition.Y) / valueSlider.AbsoluteSize.Y
        return math.clamp(1 - y, 0, 1)
    end

    valueSlider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local newV = getValuePos(input)
            setHSV(h, s, newV)
            local conn, relConn
            conn = UserInputService.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement then
                    local newV = getValuePos(input)
                    setHSV(h, s, newV)
                end
            end)
            relConn = UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    conn:Disconnect()
                    relConn:Disconnect()
                end
            end)
        end
    end)

    hexBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            local hex = hexBox.Text:gsub("#", "")
            if #hex == 6 then
                local color = HexToColor3(hex)
                local newH, newS, newV = color:ToHSV()
                setHSV(newH, newS, newV)
            else
                hexBox.Text = Color3ToHex(currentColor)
            end
        end
    end)

    row.MouseButton1Click:Connect(function()
        popup.Visible = not popup.Visible
        if popup.Visible then
            popup.Position = UDim2.new(0.5, 0, 0.5, 0)
        end
    end)

    return {
        Set = function(color)
            local newH, newS, newV = color:ToHSV()
            setHSV(newH, newS, newV)
        end,
        Get = function() return currentColor end,
    }
end

