function Window.new(options)
    options = options or {}
    local self = setmetatable({}, Window)

    self.Title = options.Title or "Division"
    self.Center = options.Center ~= false
    self.AutoShow = options.AutoShow ~= false
    self.TabPadding = options.TabPadding or 8
    self.MenuFadeTime = options.MenuFadeTime or 0.2
    self.Keybinds = {}
    self.WatermarkText = options.Watermark or "Division 2.72 | NA | not connected | 75"
    self.ToggleKey = options.ToggleKey or Enum.KeyCode.RightShift

    self.Gui = New("ScreenGui", Player:WaitForChild("PlayerGui"), {
        Name = "DivisionUI",
        Enabled = true, -- we'll control visibility via tween
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })

    self.MainFrame = New("Frame", self.Gui, {
        Name = "Main",
        BackgroundTransparency = 1,
        Size = WINDOW_SIZE,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = self.Center and UDim2.new(0.5, 0, 0.5, 0) or UDim2.new(0, 0, 0, 0),
        BorderSizePixel = 0,
    })

    -- Background (solid) – will be tweened for fade effect
    self.Background = New("Frame", self.MainFrame, {
        Name = "Background",
        ZIndex = 0,
        BackgroundColor3 = COLORS.Background,
        Size = UDim2.new(1, 0, 1, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BorderSizePixel = 0,
        BackgroundTransparency = 1, -- start hidden
    })

    -- Top bar – draggable
    self.TopBar = New("Frame", self.MainFrame, {
        Name = "Top",
        ZIndex = 1,
        BackgroundColor3 = COLORS.TopBar,
        Size = UDim2.new(1, -2, 0, TAB_HEIGHT),
        Position = UDim2.new(0.5, 0, 0.03, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BorderSizePixel = 0,
        BackgroundTransparency = 1,
    })
    New("UIStroke", self.TopBar, { Color = COLORS.Border })

    self.TitleLabel = New("TextLabel", self.TopBar, {
        Name = "Label",
        BackgroundTransparency = 1,
        Text = self.Title,
        TextColor3 = COLORS.Text,
        FontFace = FONTS.Bold,
        TextScaled = true,
        TextSize = 14,
        TextYAlignment = Enum.TextYAlignment.Top,
        Size = UDim2.new(0.9, 0, 0.8, 0),
        Position = UDim2.new(0.5, 0, 0.45, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BorderSizePixel = 0,
    })
    New("UITextSizeConstraint", self.TitleLabel)

    -- Tabs container – centered
    self.TabsContainer = New("Frame", self.MainFrame, {
        Name = "TabsContainer",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, TAB_HEIGHT),
        Position = UDim2.new(0.5, 0, 0, TAB_HEIGHT + 3),
        AnchorPoint = Vector2.new(0.5, 0),
        ZIndex = 1,
    })
    local tabsLayout = New("UIListLayout", self.TabsContainer, {
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
    })

    -- Content container – repositioned to {0.5, 0}, {0, 43} with anchor (0.5, 0)
    self.ContentContainer = New("Frame", self.MainFrame, {
        Name = "ContentContainer",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, -43),  -- fill from y=43 to bottom
        Position = UDim2.new(0.5, 0, 0, 43),
        AnchorPoint = Vector2.new(0.5, 0),
        ZIndex = 1,
    })

    -- Watermark (top-left)
    self.WatermarkLabel = New("TextLabel", self.MainFrame, {
        Name = "Watermark",
        BackgroundTransparency = 1,
        Text = self.WatermarkText,
        TextColor3 = Color3.fromRGB(180, 180, 180),
        FontFace = FONTS.Default,
        TextScaled = false,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Size = UDim2.new(0, 300, 0, 14),
        Position = UDim2.new(0, 6, 0, 6),
        AnchorPoint = Vector2.new(0, 0),
        ZIndex = 2,
    })

    self.Tabs = {}
    self.ActiveTab = nil

    -- Dragging logic
    local dragging = false
    local dragStart, startPos

    local function updatePosition(input)
        local delta = input.Position - dragStart
        self.MainFrame.Position = UDim2.new(
            0.5, startPos.X.Offset + delta.X,
            0.5, startPos.Y.Offset + delta.Y
        )
    end

    self.TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = self.MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    self.TopBar.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updatePosition(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updatePosition(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    -- Keybinds
    self.KeybindConnection = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            local callback = self.Keybinds[input.KeyCode]
            if callback then
                callback()
            end
        end
    end)

    if self.ToggleKey then
        self.ToggleConnection = UserInputService.InputBegan:Connect(function(input, processed)
            if processed then return end
            if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == self.ToggleKey then
                self:ToggleVisibility()
            end
        end)
    end

    -- Initial tween to show if AutoShow
    if self.AutoShow then
        self:FadeIn()
    else
        self.Background.BackgroundTransparency = 1
        self.TopBar.BackgroundTransparency = 1
        self.TitleLabel.TextTransparency = 1
        -- hide content?
    end

    return self
end

-- ───── Fade In/Out ─────
function Window:FadeIn()
    if not self.Gui.Enabled then return end
    local tweenInfo = TweenInfo.new(self.MenuFadeTime or 0.2, Enum.EasingStyle.Linear)
    local props = { BackgroundTransparency = 0 }
    local bgTween = TweenService:Create(self.Background, tweenInfo, props)
    local topTween = TweenService:Create(self.TopBar, tweenInfo, props)
    local titleTween = TweenService:Create(self.TitleLabel, tweenInfo, { TextTransparency = 0 })
    bgTween:Play()
    topTween:Play()
    titleTween:Play()
end

function Window:FadeOut()
    if not self.Gui.Enabled then return end
    local tweenInfo = TweenInfo.new(self.MenuFadeTime or 0.2, Enum.EasingStyle.Linear)
    local props = { BackgroundTransparency = 1 }
    local bgTween = TweenService:Create(self.Background, tweenInfo, props)
    local topTween = TweenService:Create(self.TopBar, tweenInfo, props)
    local titleTween = TweenService:Create(self.TitleLabel, tweenInfo, { TextTransparency = 1 })
    bgTween:Play()
    topTween:Play()
    titleTween:Play()
    -- Wait and disable GUI
    task.wait(self.MenuFadeTime or 0.2)
    self.Gui.Enabled = false
end

function Window:ToggleVisibility()
    if self.Gui.Enabled then
        -- currently visible, fade out
        self:FadeOut()
    else
        self.Gui.Enabled = true
        self:FadeIn()
    end
end

function Window:Show()
    self.Gui.Enabled = true
    self:FadeIn()
end

function Window:Hide()
    self:FadeOut()
end

-- ───── Watermark setter ─────
function Window:SetWatermark(text)
    self.WatermarkText = text
    self.WatermarkLabel.Text = text
end

-- ───── CreateTab ─────
function Window:CreateTab(name, isDefault)
    local button = New("TextButton", self.TabsContainer, {
        Name = name,
        Text = name,
        TextColor3 = COLORS.Text,
        BackgroundColor3 = COLORS.Background,
        FontFace = FONTS.Bold,
        TextScaled = true,
        TextSize = 14,
        Size = UDim2.new(0, 118, 1, 0),
        BorderSizePixel = 0,
        AutoButtonColor = false,
        BackgroundTransparency = 1,
    })
    New("UIStroke", button, { Color = COLORS.Border })

    task.spawn(function()
        local textService = game:GetService("TextService")
        local params = Instance.new("GetTextBoundsParams")
        params.Text = name
        params.Size = 14
        params.Font = FONTS.Bold
        local bounds = textService:GetTextBoundsAsync(params)
        button.Size = UDim2.new(0, bounds.X + 5, 1, 0)
    end)

    local content = New("Frame", self.ContentContainer, {
        Name = name,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Visible = isDefault or false,
    })

    local leftPanel = New("Frame", content, {
        Name = "Left",
        BackgroundTransparency = 1,
        Size = UDim2.new(0.5, -2, 1, 0),
    })
    local leftLayout = New("UIListLayout", leftPanel, {
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    local rightPanel = New("Frame", content, {
        Name = "Right",
        BackgroundTransparency = 1,
        Size = UDim2.new(0.5, -2, 1, 0),
        Position = UDim2.new(0.5, 0, 0, 0),
    })
    local rightLayout = New("UIListLayout", rightPanel, {
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        Padding = UDim.new(0, 10),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    local tab = {
        Name = name,
        Button = button,
        Content = content,
        LeftPanel = leftPanel,
        RightPanel = rightPanel,
        LeftLayout = leftLayout,
        RightLayout = rightLayout,
        Sections = {},
        Window = self,
        CreateSection = function(self, name, side)
            return Section.new(self, name, side)
        end
    }

    button.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    table.insert(self.Tabs, tab)
    if isDefault then self:SelectTab(tab) end
    return tab
end

function Window:SelectTab(tab)
    if self.ActiveTab == tab then return end
    for _, t in ipairs(self.Tabs) do
        t.Content.Visible = false
        t.Button.TextColor3 = COLORS.Text
    end
    tab.Content.Visible = true
    tab.Button.TextColor3 = COLORS.Accent
    self.ActiveTab = tab
end

function Window:Destroy()
    if self.KeybindConnection then self.KeybindConnection:Disconnect() end
    if self.ToggleConnection then self.ToggleConnection:Disconnect() end
    self.Gui:Destroy()
end

-- ─────────────────────────────────────────────────────────────
--  Library entry
-- ─────────────────────────────────────────────────────────────
function Division:CreateWindow(options)
    return Window.new(options)
end

return Division
