-- ─── Key string conversion ──────────────────────────────
local KEY_NAMES = {
    ["LeftMouse"] = "Mouse1",
    ["RightMouse"] = "Mouse2",
    ["MiddleMouse"] = "Mouse3",
    ["X1"] = "X1",
    ["X2"] = "X2",
    -- keyboard keys are named by their Enum name
}
local function keyToDisplay(inputType, keyCode)
    if inputType == Enum.UserInputType.MouseButton1 then return "Mouse1"
    elseif inputType == Enum.UserInputType.MouseButton2 then return "Mouse2"
    elseif inputType == Enum.UserInputType.MouseButton3 then return "Mouse3"
    elseif inputType == Enum.UserInputType.MouseButton4 then return "X1"
    elseif inputType == Enum.UserInputType.MouseButton5 then return "X2"
    elseif inputType == Enum.UserInputType.Keyboard then return keyCode.Name
    else return "None" end
end

local function parseKey(str)
    if str == "Mouse1" then return Enum.UserInputType.MouseButton1, nil
    elseif str == "Mouse2" then return Enum.UserInputType.MouseButton2, nil
    elseif str == "Mouse3" then return Enum.UserInputType.MouseButton3, nil
    elseif str == "X1" then return Enum.UserInputType.MouseButton4, nil
    elseif str == "X2" then return Enum.UserInputType.MouseButton5, nil
    else
        -- assume keyboard
        for _, key in pairs(Enum.KeyCode:GetEnumItems()) do
            if key.Name == str then return Enum.UserInputType.Keyboard, key end
        end
        return Enum.UserInputType.Keyboard, Enum.KeyCode.None
    end
end

-- ─── Tween helpers ──────────────────────────────────────
local function tweenProperty(obj, prop, target, duration)
    duration = duration or 0.15
    local tween = TweenService:Create(obj, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { [prop] = target })
    tween:Play()
    return tween
end

