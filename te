-- ─── Slider ──────────────────────────────────────────────
function Section:AddSlider(options)
    options = options or {}
    local text = options.Text or "Slider"
    local default = options.Default or 50
    local min = options.Min or 0
    local max = options.Max or 100
    local rounding = options.Rounding or 1
    local callback = options.Callback or function() end

    self._elementIndex = self._elementIndex + 1
    local z = 3000 - self._elementIndex

    local row = New("Frame", self.ItemsContainer, {
        Name = "Slider",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 18),
        BorderSizePixel = 0,
        LayoutOrder = #self.ItemsContainer:GetChildren() + 1,
        ZIndex = z,
    })

    -- Label with value
    local label = New("TextLabel", row, {
        Name = "Text",
        BackgroundTransparency = 1,
        Text = text .. "  " .. tostring(default),
        TextColor3 = COLORS.Text,
        FontFace = FONTS.Default,
        TextScaled = false,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Size = UDim2.new(1, 0, 0, 9),
        Position = UDim2.new(0, 0, 0, 0),
        BorderSizePixel = 0,
        ZIndex = z,
    })

    -- Slider track
    local sliderOuter = New("Frame", row, {
        Name = "SliderOuter",
        BackgroundColor3 = COLORS.ToggleOff,
        ClipsDescendants = true,
        Size = UDim2.new(1, 0, 0, 4),
        Position = UDim2.new(0, 0, 0.75, 0),
        BorderSizePixel = 0,
        ZIndex = z,
    })
    New("UICorner", sliderOuter, { CornerRadius = UDim.new(1, 0) })

    -- Slider fill
    local sliderFill = New("Frame", sliderOuter, {
        Name = "SliderFill",
        BackgroundColor3 = COLORS.Accent,
        Size = UDim2.new(1, 0, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        BorderSizePixel = 0,
        ZIndex = z,
    })
    New("UICorner", sliderFill, { CornerRadius = UDim.new(1, 0) })

    -- Slider knob
    local knob = New("Frame", sliderOuter, {
        Name = "Knob",
        BackgroundColor3 = COLORS.Text,
        Size = UDim2.new(0, 10, 0, 10),
        Position = UDim2.new(1, -5, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        BorderSizePixel = 0,
        ZIndex = z + 1,
    })
    New("UICorner", knob, { CornerRadius = UDim.new(1, 0) })

    local value = default
    local function setValue(newVal)
        newVal = math.clamp(newVal, min, max)
        if rounding then newVal = math.round(newVal / rounding) * rounding end
        value = newVal
        label.Text = text .. "  " .. tostring(value)
        local percent = (value - min) / (max - min)
        tweenProperty(sliderFill, "Size", UDim2.new(percent, 0, 1, 0), 0.1)
        knob.Position = UDim2.new(percent, -5, 0.5, 0)
        callback(value)
    end

    setValue(default)

    local dragging = false
    sliderOuter.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            local conn, relConn
            conn = UserInputService.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
                    local pos = input.Position.X - sliderOuter.AbsolutePosition.X
                    local percent = math.clamp(pos / sliderOuter.AbsoluteSize.X, 0, 1)
                    local newVal = min + (max - min) * percent
                    setValue(newVal)
                end
            end)
            relConn = UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                    conn:Disconnect()
                    relConn:Disconnect()
                end
            end)
        end
    end)

    return {
        Set = setValue,
        Get = function() return value end,
    }
end

