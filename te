function Division:CreateWindow(options)
    if _G.DivisionUI_Window then
        _G.DivisionUI_Window:Destroy()
        _G.DivisionUI_Window = nil
    end
    local window = Window.new(options)
    _G.DivisionUI_Window = window
    return window
end

return Division
