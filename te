            BorderSizePixel = 0,
            AutoButtonColor = false,
            ZIndex = z + 20,
        })
        item.MouseEnter:Connect(function()
            item.TextColor3 = COLORS.Text
        end)
        item.MouseLeave:Connect(function()
            item.TextColor3 = (item.Text == selected) and COLORS.Accent or COLORS.TextDim
        end)
        item.MouseButton1Click:Connect(function()
            setSelected(val)
            itemsFrame.Visible = false
            arrow.Text = "▾"
        end)
    end

    dropdownFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            itemsFrame.Visible = not itemsFrame.Visible
            arrow.Text = itemsFrame.Visible and "▴" or "▾"
            local count = #itemsFrame:GetChildren()
            itemsFrame.Size = UDim2.new(0, 140, 0, math.min(count * 16 + 4, 60))
        end
    end)

    return {
        Set = setSelected,
        Get = function() return selected end,
        Row = row,
    }
end

-- ─── Keybind ──────────────────────────────────────────────
function Section:AddKeybind(options)
    options = options or {}
    local text = options.Text or "Keybind"
    local defaultKey = options.Default or "R"
    local mode = options.Mode or "Toggle"
    local callback = options.Callback or function() end

    self._elementIndex = self._elementIndex + 1
    local z = 3000 - self._elementIndex

    local row = New("Frame", self.ItemsContainer, {
        Name = "Keybind",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, ITEM_HEIGHT + 4),
        BorderSizePixel = 0,
        LayoutOrder = #self.ItemsContainer:GetChildren() + 1,
        ZIndex = z,
    })

    local label = New("TextLabel", row, {
        BackgroundTransparency = 1,
        Text = text .. ":",
        TextColor3 = COLORS.Text,
        FontFace = FONTS.Default,
        TextScaled = false,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Size = UDim2.new(0, 120, 0, 9),
        Position = UDim2.new(0, 0, 0.5, -4.5),
        BorderSizePixel = 0,
        ZIndex = z,
    })

    -- Mode dropdown
    local modeDropdown = self:AddDropdown({
        Text = "",
        Values = {"Toggle", "Hold", "Always"},
        Default = mode,
        Callback = function(v) mode = v end
    })
    local modeFrame = modeDropdown.Row
    modeFrame.Parent = row
    modeFrame.Size = UDim2.new(0, 70, 0, 14)
    modeFrame.Position = UDim2.new(0, 130, 0.5, 0)
    modeFrame.AnchorPoint = Vector2.new(0, 0.5)
    modeFrame.ZIndex = z

    -- Key button
    local keyButton = New("TextButton", row, {
        Name = "KeyButton",
        BackgroundTransparency = 1,
        Text = getKeyDisplayName(defaultKey),
        TextColor3 = COLORS.Accent,
        FontFace = FONTS.Bold,
        TextScaled = false,
        TextSize = 12,
        Size = UDim2.new(0, 60, 0, ITEM_HEIGHT),
        Position = UDim2.new(1, -4, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        BorderSizePixel = 0,
        AutoButtonColor = false,
        ZIndex = z,
    })

    -- Underline for key button
    local underline = New("Frame", keyButton, {
        Name = "Underline",
        BackgroundColor3 = COLORS.Accent,
        Size = UDim2.new(0.8, 0, 0, 2),
        Position = UDim2.new(0.5, 0, 1, -2),
        AnchorPoint = Vector2.new(0.5, 0),
        BorderSizePixel = 0,
        ZIndex = z,
    })
    New("UICorner", underline, { CornerRadius = UDim.new(1, 0) })

    local function updateKeyButtonWidth()
        local textService = game:GetService("TextService")
        local params = Instance.new("GetTextBoundsParams")
        params.Text = keyButton.Text
        params.Size = 12
        params.Font = FONTS.Bold
        local bounds = textService:GetTextBoundsAsync(params)
        keyButton.Size = UDim2.new(0, math.max(bounds.X + 12, 40), 0, ITEM_HEIGHT)
    end
    task.spawn(updateKeyButtonWidth)

    keyButton.MouseEnter:Connect(function()
        keyButton.TextColor3 = COLORS.AccentHover
        underline.BackgroundColor3 = COLORS.AccentHover
    end)
    keyButton.MouseLeave:Connect(function()
        keyButton.TextColor3 = COLORS.Accent
        underline.BackgroundColor3 = COLORS.Accent
    end)

    local currentKey = defaultKey
    local window = self.Tab.Window

    local function setKey(keyDisplay)
        currentKey = keyDisplay
        keyButton.Text = getKeyDisplayName(keyDisplay)
        updateKeyButtonWidth()
        for _, binding in ipairs(window.Keybinds) do
            if binding.row == row then
                binding.key = keyDisplay
                break
            end
        end
    end

    keyButton.MouseButton1Click:Connect(function()
        keyButton.Text = "..."
        underline.BackgroundColor3 = COLORS.AccentHover
        local listening = true
        local conn
        conn = UserInputService.InputBegan:Connect(function(input, processed)
            if not listening then return end
            if processed then return end
            local display
            if input.UserInputType == Enum.UserInputType.Keyboard then
                display = input.KeyCode.Name
            elseif input.UserInputType == Enum.UserInputType.MouseButton1 then display = "Mouse1"
            elseif input.UserInputType == Enum.UserInputType.MouseButton2 then display = "Mouse2"
            elseif input.UserInputType == Enum.UserInputType.MouseButton3 then display = "Mouse3"
            elseif input.UserInputType == Enum.UserInputType.MouseButton4 then display = "X1"
            elseif input.UserInputType == Enum.UserInputType.MouseButton5 then display = "X2"
            else return end
            listening = false
            conn:Disconnect()
            setKey(display)
            underline.BackgroundColor3 = COLORS.Accent
        end)
        local cancelConn
        cancelConn = keyButton.MouseButton1Click:Connect(function()
            if listening then
                listening = false
                conn:Disconnect()
                cancelConn:Disconnect()
                setKey(currentKey)
                underline.BackgroundColor3 = COLORS.Accent
            end
        end)
    end)

    local binding = { key = currentKey, mode = mode, callback = callback, active = false, row = row }
    table.insert(window.Keybinds, binding)

    return {
        SetKey = setKey,
        GetKey = function() return currentKey end,
        SetMode = function(v) mode = v; modeDropdown:Set(v) end,
        GetMode = function() return mode end,
    }
end

