        Name = "ItemsFrame",
        Visible = false,
        Active = true,
        BackgroundColor3 = COLORS.DropdownBg,
        Size = UDim2.new(0, 140, 0, 30),
        Position = UDim2.new(0, 0, 0.97, 0),
        BorderSizePixel = 0,
        ScrollBarImageColor3 = Color3.new(0,0,0),
        ZIndex = z + 20,
        ClipsDescendants = false,
    })
    New("UICorner", itemsFrame, { CornerRadius = UDim.new(0, 4) })
    New("UIListLayout", itemsFrame, {
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2),
    })

    local selected = default
    local function setSelected(value)
        selected = value
        dropdownText.Text = value
        callback(value)
        for _, child in ipairs(itemsFrame:GetChildren()) do
            if child:IsA("TextButton") then
                child.TextColor3 = (child.Text == value) and COLORS.Accent or COLORS.TextDim
            end
        end
    end

    for _, val in ipairs(values) do
        local item = New("TextButton", itemsFrame, {
            Name = "Item",
            Text = val,
            TextColor3 = (val == default) and COLORS.Accent or COLORS.TextDim,
            BackgroundTransparency = 1,
            FontFace = FONTS.Default,
            TextScaled = false,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
