-- ─── Key display names ──────────────────────────────────
local KEY_DISPLAY_NAMES = {
    RightShift = "Right Shift",
    LeftShift = "Left Shift",
    RightControl = "Right Ctrl",
    LeftControl = "Left Ctrl",
    RightAlt = "Right Alt",
    LeftAlt = "Left Alt",
