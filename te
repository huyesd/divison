    self.Center = options.Center ~= false
    self.AutoShow = options.AutoShow ~= false
    self.TabPadding = options.TabPadding or 8
    self.MenuFadeTime = options.MenuFadeTime or 0.2
    self.Keybinds = {} -- table of {key, mode, callback, active}
    self.WatermarkText = options.Watermark or "Division 2.72 | NA | not connected | 75"
    self.ToggleKey = options.ToggleKey or Enum.KeyCode.RightShift
    self.CreateSettingsTab = options.CreateSettingsTab ~= false

    self.Gui = New("ScreenGui", CoreGui, {
        Name = "DivisionUI",
        Enabled = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,  -- <-- makes UI ignore safe area
    })

    -- Watermark (top-left)
    self.WatermarkLabel = New("TextLabel", self.Gui, {
        Name = "Watermark",
        BackgroundTransparency = 1,
        Text = self.WatermarkText,
        TextColor3 = Color3.fromRGB(180, 180, 180),
        FontFace = FONTS.Default,
        TextScaled = false,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Size = UDim2.new(0, 300, 0, 14),
        Position = UDim2.new(0, 10, 0, 10),
        AnchorPoint = Vector2.new(0, 0),
        ZIndex = 10,
    })

    -- Main window frame
    self.MainFrame = New("Frame", self.Gui, {
        Name = "Main",
        BackgroundTransparency = 1,
        Size = WINDOW_SIZE,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = self.Center and UDim2.new(0.5, 0, 0.5, 0) or UDim2.new(0, 0, 0, 0),
        BorderSizePixel = 0,
    })

    -- Background (fade)
    self.Background = New("Frame", self.MainFrame, {
        Name = "Background",
        ZIndex = 0,
        BackgroundColor3 = COLORS.Background,
        Size = UDim2.new(1, 0, 1, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BorderSizePixel = 0,
        BackgroundTransparency = 1,
    })

    -- Top bar
    self.TopBar = New("Frame", self.MainFrame, {
        Name = "Top",
        ZIndex = 1,
        BackgroundColor3 = COLORS.TopBar,
        Size = UDim2.new(1, -2, 0, TAB_HEIGHT),
        Position = UDim2.new(0.5, 0, 0.03, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BorderSizePixel = 0,
        BackgroundTransparency = 1,
    })
    New("UIStroke", self.TopBar, { Color = COLORS.Border })

    self.TitleLabel = New("TextLabel", self.TopBar, {
        Name = "Label",
        BackgroundTransparency = 1,
        Text = self.Title,
        TextColor3 = COLORS.Text,
        FontFace = FONTS.Bold,
        TextScaled = true,
        TextSize = 14,
        TextYAlignment = Enum.TextYAlignment.Top,
        Size = UDim2.new(0.9, 0, 0.8, 0),
        Position = UDim2.new(0.5, 0, 0.45, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BorderSizePixel = 0,
        TextTransparency = 1,
    })
    New("UITextSizeConstraint", self.TitleLabel)

    -- Tabs container (centered)
    self.TabsContainer = New("Frame", self.MainFrame, {
        Name = "TabsContainer",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, TAB_HEIGHT),
        Position = UDim2.new(0.5, 0, 0, TAB_HEIGHT + 3),
        AnchorPoint = Vector2.new(0.5, 0),
        ZIndex = 1,
    })
    New("UIListLayout", self.TabsContainer, {
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
    })

    -- Content container
    self.ContentContainer = New("Frame", self.MainFrame, {
        Name = "ContentContainer",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, -43),
        Position = UDim2.new(0.5, 0, 0, 43),
        AnchorPoint = Vector2.new(0.5, 0),
        ZIndex = 1,
    })

    self.Tabs = {}
    self.ActiveTab = nil

    -- Smooth drag (as before)
    -- ... (same code as last version)

    -- Keybind listener
    self.KeybindConnection = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        -- iterate over bindings
        for _, binding in ipairs(self.Keybinds) do
            local key = binding.key
            local mode = binding.mode
            local callback = binding.callback
            local inputType, keyCode = parseKey(key)
            if inputType then
                local match = false
                if inputType == Enum.UserInputType.Keyboard then
                    match = input.KeyCode == keyCode
                else
                    match = input.UserInputType == inputType
                end
                if match then
                    if mode == "Toggle" then
                        binding.active = not binding.active
                        callback(binding.active)
                    elseif mode == "Hold" then
                        binding.active = true
                        callback(true)
                    elseif mode == "Always" then
                        callback(true)
                    end
                end
            end
        end
    end)

    self.KeybindEndConnection = UserInputService.InputEnded:Connect(function(input, processed)
        if processed then return end
        for _, binding in ipairs(self.Keybinds) do
            if binding.mode == "Hold" then
                local inputType, keyCode = parseKey(binding.key)
                if inputType then
                    local match = false
                    if inputType == Enum.UserInputType.Keyboard then
                        match = input.KeyCode == keyCode
                    else
                        match = input.UserInputType == inputType
                    end
                    if match then
                        binding.active = false
                        binding.callback(false)
                    end
                end
            end
        end
    end)

    -- Built‑in toggle keybind (RightShift)
    if self.ToggleKey then
        self.ToggleConnection = UserInputService.InputBegan:Connect(function(input, processed)
            if processed then return end
            if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == self.ToggleKey then
                self:ToggleVisibility()
            end
        end)
    end

    -- Create default Settings tab if requested
    if self.CreateSettingsTab then
        self:CreateDefaultSettingsTab()
    end

    if self.AutoShow then self:FadeIn() end

    return self
end

