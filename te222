        Position = UDim2.new(0.5, 0, 0.03, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BorderSizePixel = 0,
        BackgroundTransparency = 1,
    })
    New("UIStroke", self.TopBar, { Color = COLORS.Border })

    self.TitleLabel = New("TextLabel", self.TopBar, {
        Name = "Label",
        BackgroundTransparency = 1,
        Text = self.Title,
        TextColor3 = COLORS.Text,
        FontFace = FONTS.Bold,
        TextScaled = true,
        TextSize = 14,
        TextYAlignment = Enum.TextYAlignment.Top,
        Size = UDim2.new(0.9, 0, 0.8, 0),
        Position = UDim2.new(0.5, 0, 0.45, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BorderSizePixel = 0,
        TextTransparency = 1,
        ZIndex = 1001,
    })
    New("UITextSizeConstraint", self.TitleLabel)

    -- Tabs container
    self.TabsContainer = New("Frame", self.MainFrame, {
        Name = "TabsContainer",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, TAB_HEIGHT),
        Position = UDim2.new(0.5, 0, 0, TAB_HEIGHT + 3),
        AnchorPoint = Vector2.new(0.5, 0),
        ZIndex = 1001,
    })
    New("UIListLayout", self.TabsContainer, {
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
    })

    -- Content container
    self.ContentContainer = New("Frame", self.MainFrame, {
        Name = "ContentContainer",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, -43),
        Position = UDim2.new(0.5, 0, 0, 43),
        AnchorPoint = Vector2.new(0.5, 0),
        ZIndex = 1001,
    })

    self.Tabs = {}
    self.ActiveTab = nil

    -- Smooth drag (using RunService)
    local dragData = { active = false, startMouse = nil, startPos = nil, connection = nil }

    local function updateDrag()
        if not dragData.active then return end
        local mousePos = UserInputService:GetMouseLocation()
        local delta = mousePos - dragData.startMouse
        self.MainFrame.Position = UDim2.new(
            0.5, dragData.startPos.X.Offset + delta.X,
            0.5, dragData.startPos.Y.Offset + delta.Y
        )
    end

    self.TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragData.active = true
            dragData.startMouse = UserInputService:GetMouseLocation()
            dragData.startPos = self.MainFrame.Position
            if dragData.connection then dragData.connection:Disconnect() end
            dragData.connection = RunService.Heartbeat:Connect(updateDrag)
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragData.active = false
                    if dragData.connection then
                        dragData.connection:Disconnect()
                        dragData.connection = nil
                    end
                end
            end)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragData.active = false
            if dragData.connection then
                dragData.connection:Disconnect()
                dragData.connection = nil
            end
        end
    end)

    -- Keybind listener
    self.KeybindConnection = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        for _, binding in ipairs(self.Keybinds) do
            local key = binding.key
            local mode = binding.mode
            local callback = binding.callback
            local inputType, keyCode = parseKey(key)
            if inputType then
                local match = false
                if inputType == Enum.UserInputType.Keyboard then
                    match = (input.KeyCode == keyCode)
                else
                    match = (input.UserInputType == inputType)
                end
                if match then
                    if mode == "Toggle" then
                        binding.active = not binding.active
                        callback(binding.active)
                    elseif mode == "Hold" then
                        binding.active = true
                        callback(true)
                    elseif mode == "Always" then
                        callback(true)
                    end
                end
            end
        end
    end)

    self.KeybindEndConnection = UserInputService.InputEnded:Connect(function(input, processed)
        if processed then return end
        for _, binding in ipairs(self.Keybinds) do
            if binding.mode == "Hold" then
                local inputType, keyCode = parseKey(binding.key)
                if inputType then
                    local match = false
                    if inputType == Enum.UserInputType.Keyboard then
                        match = (input.KeyCode == keyCode)
                    else
                        match = (input.UserInputType == inputType)
                    end
                    if match then
                        binding.active = false
                        binding.callback(false)
                    end
                end
            end
        end
    end)

    -- Built‑in toggle key
    if self.ToggleKey then
        self.ToggleConnection = UserInputService.InputBegan:Connect(function(input, processed)
            if processed then return end
            if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == self.ToggleKey then
                self:ToggleVisibility()
            end
        end)
    end

    if self.AutoShow then self:FadeIn() end

    return self
end

-- ─── Manual Settings tab creator ──────────────────────
function Window:CreateSettingsTab()
    local settingsTab = self:CreateTab("Settings", false)

    local configSection = settingsTab:CreateSection("Configs", "Left")
    configSection:AddDropdown({
        Text = "",
        Values = {"Custom 1", "Custom 2", "Custom 3"},
        Default = "Custom 1",
    })
    configSection:AddButton({ Text = "Load", Callback = function() print("Load config") end })
    configSection:AddButton({ Text = "Save", Callback = function() print("Save config") end })
    configSection:AddButton({ Text = "Reset", Callback = function() print("Reset config") end })

    local menuSection = settingsTab:CreateSection("Menu", "Right")
    menuSection:AddKeybind({
        Text = "Menu Key",
        Default = "RightShift",
        Mode = "Toggle",
        Callback = function(state)
            if state then self:ToggleVisibility() end
        end
    })

    return settingsTab
end

-- ─── Tween methods ──────────────────────────────────────
function Window:FadeIn()
    if not self.Gui.Enabled then return end
    local tweenInfo = TweenInfo.new(self.MenuFadeTime, Enum.EasingStyle.Linear)
    local bgTween = TweenService:Create(self.Background, tweenInfo, { BackgroundTransparency = 0 })
    local topTween = TweenService:Create(self.TopBar, tweenInfo, { BackgroundTransparency = 0 })
    local titleTween = TweenService:Create(self.TitleLabel, tweenInfo, { TextTransparency = 0 })
    bgTween:Play()
    topTween:Play()
    titleTween:Play()
end

function Window:FadeOut()
    if not self.Gui.Enabled then return end
    local tweenInfo = TweenInfo.new(self.MenuFadeTime, Enum.EasingStyle.Linear)
    local bgTween = TweenService:Create(self.Background, tweenInfo, { BackgroundTransparency = 1 })
    local topTween = TweenService:Create(self.TopBar, tweenInfo, { BackgroundTransparency = 1 })
    local titleTween = TweenService:Create(self.TitleLabel, tweenInfo, { TextTransparency = 1 })
    bgTween:Play()
    topTween:Play()
    titleTween:Play()
    task.wait(self.MenuFadeTime)
    self.Gui.Enabled = false
end

function Window:ToggleVisibility()
    if self.Gui.Enabled then self:FadeOut() else self.Gui.Enabled = true; self:FadeIn() end
end

function Window:Show()
    self.Gui.Enabled = true
    self:FadeIn()
end

function Window:Hide()
    self:FadeOut()
end

function Window:SetWatermark(text)
    self.WatermarkText = text
    self.WatermarkLabel.Text = text
end

-- ─── CreateTab ──────────────────────────────────────────
function Window:CreateTab(name, isDefault)
    local button = New("TextButton", self.TabsContainer, {
        Name = name,
        Text = name,
        TextColor3 = COLORS.Text,
        BackgroundColor3 = COLORS.Background,
        FontFace = FONTS.Bold,
        TextScaled = true,
        TextSize = 14,
        Size = UDim2.new(0, 118, 1, 0),
        BorderSizePixel = 0,
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        ZIndex = 1001,
    })
    New("UIStroke", button, { Color = COLORS.Border })

    task.spawn(function()
        local textService = game:GetService("TextService")
        local params = Instance.new("GetTextBoundsParams")
        params.Text = name
        params.Size = 14
        params.Font = FONTS.Bold
        local bounds = textService:GetTextBoundsAsync(params)
        button.Size = UDim2.new(0, bounds.X + 5, 1, 0)
    end)

    local content = New("Frame", self.ContentContainer, {
        Name = name,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Visible = isDefault or false,
        ZIndex = 1001,
    })

    local leftPanel = New("Frame", content, {
        Name = "Left",
        BackgroundTransparency = 1,
        Size = UDim2.new(0.5, -2, 1, 0),
        ZIndex = 1001,
    })
    New("UIListLayout", leftPanel, {
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    local rightPanel = New("Frame", content, {
        Name = "Right",
        BackgroundTransparency = 1,
        Size = UDim2.new(0.5, -2, 1, 0),
        Position = UDim2.new(0.5, 0, 0, 0),
        ZIndex = 1001,
    })
    New("UIListLayout", rightPanel, {
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        Padding = UDim.new(0, 10),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    local tab = {
        Name = name,
        Button = button,
        Content = content,
        LeftPanel = leftPanel,
        RightPanel = rightPanel,
        Sections = {},
        Window = self,
        CreateSection = function(self, name, side)
            return Section.new(self, name, side)
        end
    }

    button.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    table.insert(self.Tabs, tab)
    if isDefault then self:SelectTab(tab) end
    return tab
end

function Window:SelectTab(tab)
    if self.ActiveTab == tab then return end
    for _, t in ipairs(self.Tabs) do
        t.Content.Visible = false
        t.Button.TextColor3 = COLORS.Text
    end
    tab.Content.Visible = true
    tab.Button.TextColor3 = COLORS.Accent
    self.ActiveTab = tab
end

function Window:Destroy()
    if self.KeybindConnection then self.KeybindConnection:Disconnect() end
    if self.KeybindEndConnection then self.KeybindEndConnection:Disconnect() end
    if self.ToggleConnection then self.ToggleConnection:Disconnect() end
    self.Gui:Destroy()
end

