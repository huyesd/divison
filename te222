-- ─── Keybind (with mouse support, modes, auto-size, hover) ──
function Section:AddKeybind(options)
    options = options or {}
    local text = options.Text or "Keybind"
    local defaultKey = options.Default or "R"
    local mode = options.Mode or "Toggle"
    local callback = options.Callback or function() end

    self._elementIndex = self._elementIndex + 1
    local z = 3000 - self._elementIndex

    local row = New("TextButton", self.ItemsContainer, {
        Name = "Keybind",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, ITEM_HEIGHT + 4),
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        LayoutOrder = #self.ItemsContainer:GetChildren() + 1,
        ZIndex = z,
    })

    local label = New("TextLabel", row, {
        BackgroundTransparency = 1,
        Text = text .. ":",
        TextColor3 = COLORS.Text,
        FontFace = FONTS.Default,
        TextScaled = true,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        Size = UDim2.new(0, 200, 0, 9),
        Position = UDim2.new(0.07, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        LayoutOrder = 1,
        BorderSizePixel = 0,
        ZIndex = z,
    })

    -- Mode dropdown
    local modeDropdown = self:AddDropdown({
        Text = "",
        Values = {"Toggle", "Hold", "Always"},
        Default = mode,
        Callback = function(v) mode = v end
    })
    local modeFrame = modeDropdown.Row
    modeFrame.Parent = row
    modeFrame.Size = UDim2.new(0, 60, 0, 12)
    modeFrame.LayoutOrder = 2
    modeFrame.ZIndex = z  -- keep same

    -- Key button
    local keyButton = New("TextButton", row, {
        Name = "KeyButton",
        BackgroundColor3 = COLORS.ToggleOff,
        Text = defaultKey,
        TextColor3 = COLORS.Text,
        FontFace = FONTS.Bold,
        TextScaled = true,
        TextSize = 14,
        Size = UDim2.new(0, 45, 0, ITEM_HEIGHT),
        LayoutOrder = 3,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        ZIndex = z,
    })

    local function updateKeyButtonWidth()
        local textService = game:GetService("TextService")
        local params = Instance.new("GetTextBoundsParams")
        params.Text = keyButton.Text
        params.Size = 14
        params.Font = FONTS.Bold
        local bounds = textService:GetTextBoundsAsync(params)
        keyButton.Size = UDim2.new(0, math.max(bounds.X + 10, 30), 0, ITEM_HEIGHT)
    end
    task.spawn(updateKeyButtonWidth)

    keyButton.MouseEnter:Connect(function()
        keyButton.BackgroundColor3 = COLORS.Accent
        keyButton.TextColor3 = COLORS.Background
    end)
    keyButton.MouseLeave:Connect(function()
        keyButton.BackgroundColor3 = COLORS.ToggleOff
        keyButton.TextColor3 = COLORS.Text
    end)

    New("UIListLayout", row, {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = Enum.FillDirection.Horizontal,
    })

    local currentKey = defaultKey
    local window = self.Tab.Window

    local function setKey(keyDisplay)
        currentKey = keyDisplay
        keyButton.Text = keyDisplay
        updateKeyButtonWidth()
        -- Update stored binding
        for _, binding in ipairs(window.Keybinds) do
            if binding.row == row then
                binding.key = keyDisplay
                break
            end
        end
    end

    keyButton.MouseButton1Click:Connect(function()
        keyButton.Text = "..."
        local listening = true
        local conn
        conn = UserInputService.InputBegan:Connect(function(input, processed)
            if not listening then return end
            if processed then return end
            local display
            if input.UserInputType == Enum.UserInputType.Keyboard then
                display = input.KeyCode.Name
            elseif input.UserInputType == Enum.UserInputType.MouseButton1 then display = "Mouse1"
            elseif input.UserInputType == Enum.UserInputType.MouseButton2 then display = "Mouse2"
            elseif input.UserInputType == Enum.UserInputType.MouseButton3 then display = "Mouse3"
            elseif input.UserInputType == Enum.UserInputType.MouseButton4 then display = "X1"
            elseif input.UserInputType == Enum.UserInputType.MouseButton5 then display = "X2"
            else return end
            listening = false
            conn:Disconnect()
            setKey(display)
        end)
        local cancelConn
        cancelConn = keyButton.MouseButton1Click:Connect(function()
            if listening then
                listening = false
                conn:Disconnect()
                cancelConn:Disconnect()
                setKey(currentKey)
            end
        end)
    end)

    -- Store binding info
    local binding = { key = currentKey, mode = mode, callback = callback, active = false, row = row }
    table.insert(window.Keybinds, binding)

    return {
        SetKey = setKey,
        GetKey = function() return currentKey end,
        SetMode = function(v) mode = v; modeDropdown:Set(v) end,
        GetMode = function() return mode end,
    }
end

