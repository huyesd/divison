-- ─── Utility ──────────────────────────────────────────────
local function New(className, parent, properties)
    local inst = Instance.new(className)
    for prop, val in pairs(properties or {}) do inst[prop] = val end
    inst.Parent = parent
    return inst
end

local function HexToColor3(hex)
    hex = hex:gsub("#", "")
    local r = tonumber(hex:sub(1,2), 16) or 255
    local g = tonumber(hex:sub(3,4), 16) or 255
    local b = tonumber(hex:sub(5,6), 16) or 255
    return Color3.fromRGB(r, g, b)
end

local function Color3ToHex(c)
    return string.format("#%02X%02X%02X",
        math.floor(c.R * 255),
        math.floor(c.G * 255),
        math.floor(c.B * 255)
    )
end

-- ─── Tween helpers ──────────────────────────────────────
local function tweenProperty(obj, prop, target, duration)
    duration = duration or 0.15
    local tween = TweenService:Create(obj, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { [prop] = target })
    tween:Play()
    return tween
end

-- ─── Key parsing ──────────────────────────────────────
local function parseKey(str)
    if str == "Mouse1" then return Enum.UserInputType.MouseButton1, nil
    elseif str == "Mouse2" then return Enum.UserInputType.MouseButton2, nil
    elseif str == "Mouse3" then return Enum.UserInputType.MouseButton3, nil
    elseif str == "X1" then return Enum.UserInputType.MouseButton4, nil
    elseif str == "X2" then return Enum.UserInputType.MouseButton5, nil
    else
        for _, key in pairs(Enum.KeyCode:GetEnumItems()) do
            if key.Name == str then return Enum.UserInputType.Keyboard, key end
        end
        return nil, nil
    end
end

-- ─── Section class ──────────────────────────────────────
local Section = {}
Section.__index = Section

function Section.new(tab, name, side)
    side = side or "Left"
    local panel = (side == "Left") and tab.LeftPanel or tab.RightPanel

    local sectionFrame = New("Frame", panel, {
        Name = name,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 20),
        BorderSizePixel = 0,
    })

    local itemsContainer = New("Frame", sectionFrame, {
        Name = "Items",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -12, 1, -10),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BorderSizePixel = 0,
    })
    local itemsLayout = New("UIListLayout", itemsContainer, {
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    -- Counter for ZIndex: first element gets highest
    local elementIndex = 0

    local selfObj = {
        Name = name,
        Frame = sectionFrame,
        ItemsContainer = itemsContainer,
        Layout = itemsLayout,
        Tab = tab,
        Side = side,
        Elements = {},
        _elementIndex = 0, -- used to assign ZIndex
    }
    setmetatable(selfObj, Section)

    local function updateSize()
        local totalHeight = 0
        local children = itemsContainer:GetChildren()
        for _, child in ipairs(children) do
            if child:IsA("GuiObject") and child.Visible then
                totalHeight = totalHeight + child.Size.Y.Offset + itemsLayout.Padding.Offset
            end
        end
        totalHeight = totalHeight + itemsLayout.Padding.Offset * 2
        sectionFrame.Size = UDim2.new(1, 0, 0, math.max(totalHeight + 10, 20))
    end

    itemsContainer.ChildAdded:Connect(updateSize)
    itemsContainer.ChildRemoved:Connect(updateSize)
    task.wait()
    updateSize()

    return selfObj
end

